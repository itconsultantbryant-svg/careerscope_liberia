{
  "name": "careerscope-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "migrate:neon": "node scripts/migrate-neon.js",
    "migrate:postgres": "node db/migrate.js --apply",
    "test:postgres": "node --env-file=.env.neon-test.local tests/postgres-smoke.mjs",
    "test:features": "node --env-file=.env.neon-test.local tests/features-smoke.mjs",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^12.11.1",
    "express-ws": "^5.0.2",
    "simple-peer": "^9.11.1",
    "socket.io": "^4.8.4"
  }
}
