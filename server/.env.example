# Local API
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=
# Neon: server only; obtain using neonctl and store in Vercel secret env.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Real-time delivery uses the authenticated Neon event outbox; no public key.
# Billing (manual external-payment review only)
SUBSCRIPTION_AMOUNT_MINOR=2000
SUBSCRIPTION_CURRENCY=USD
PAYMENT_INSTRUCTIONS=
COMPANY_NAME=CareerScope
COMPANY_ADDRESS=Sinkor, Monrovia, Liberia
COMPANY_LOGO_URL=
# Optional invoice email delivery. Uploads are stored durably in Neon.
RESEND_API_KEY=
EMAIL_FROM=
# Optional WebRTC relay. Configure all three for restrictive networks.
# Prefer short-lived operator-issued credentials; values are shared only with invited room members.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# AI profiles are configured but deliberately inactive. No paid provider calls are made.
# Provider integration, privacy review and explicit activation are a separate step.
