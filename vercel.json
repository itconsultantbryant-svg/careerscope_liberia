{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev && npm ci --prefix client --include=dev && npm ci --prefix server --ignore-scripts",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": { "api/index.js": { "maxDuration": 60, "includeFiles": "{server/generated/**,client/public/assets/careerscope_logo.jpeg,server/node_modules/pdfkit/js/data/**}" } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/uploads/:path*", "destination": "/api" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
    { "key": "X-Frame-Options", "value": "DENY" }
  ] }]
}
